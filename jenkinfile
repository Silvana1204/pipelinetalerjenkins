pipeline {
    agent any

    environment {
        IMAGE_NAME = 'mi-app-web'
        CONTAINER_NAME = 'mi-contenedor-web'
        VM_IP = '10.100.128.142'
        VM_USER = 'vboxuser'
        SSH_CREDS = 'ssh-vm-ubuntu'
    }

    stages {

        stage('Descargar código') {
            steps {
                checkout scm
            }
        }

        stage('Construir Imagen Docker') {
            steps {
                script {
                    docker.build("${IMAGE_NAME}:latest")
                }
            }
        }

        stage('Empaquetar Imagen') {
            steps {
                echo 'Convirtiendo imagen a archivo .tar...'
                sh "docker save ${IMAGE_NAME}:latest -o ${IMAGE_NAME}.tar"
            }
        }

        stage('Enviar a Ubuntu') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: "${SSH_CREDS}",
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        scp -i $SSH_KEY -o StrictHostKeyChecking=no \
                        ${IMAGE_NAME}.tar \
                        ${VM_USER}@${VM_IP}:/tmp/${IMAGE_NAME}.tar
                    '''
                }
            }
        }

        stage('Desplegar en Ubuntu') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: "${SSH_CREDS}",
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh """
                        ssh -i \$SSH_KEY -o StrictHostKeyChecking=no ${VM_USER}@${VM_IP} '
                            docker stop ${CONTAINER_NAME} || true
                            docker rm ${CONTAINER_NAME} || true

                            docker load -i /tmp/${IMAGE_NAME}.tar

                            docker run -d \
                                -p 80:80 \
                                --name ${CONTAINER_NAME} \
                                ${IMAGE_NAME}:latest

                            rm /tmp/${IMAGE_NAME}.tar
                        '
                    """
                }
            }
        }
    }

    post {
        always {
            sh "rm -f ${IMAGE_NAME}.tar"
        }

        success {
            echo "Despliegue exitoso en ${VM_IP}"
        }

        failure {
            echo 'El despliegue falló. Revisar logs.'
        }
    }
}